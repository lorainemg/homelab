# LibreChat stack configuration.
#
# Copy this file to librechat/.env on the host (and into the corresponding
# Komodo checkout) and fill it in. Compose uses it to interpolate the explicit
# service environment below; it is not mounted into a container. Komodo's
# merged Compose config can therefore contain the values; see LEARNING.md.
#
# Never commit the filled copy. (`*/.env` is gitignored, which covers a local
# copy made for scripts/bootstrap.sh.)

# --- Public URLs ---
# Both must be the public origin, not the container address: LibreChat builds
# links and OAuth callbacks from them.
DOMAIN_CLIENT=https://librechat.sussman.win
DOMAIN_SERVER=https://librechat.sussman.win

# --- Application secrets ---
# CREDS_KEY encrypts user-held credentials at rest; rotating either value
# invalidates every stored credential.
# Generate: openssl rand -hex 32
CREDS_KEY=changeme
# Generate: openssl rand -hex 16   (exactly 16 bytes — 32 hex chars)
CREDS_IV=changeme
# Signs session tokens; rotating logs everyone out.
# Generate: openssl rand -hex 32
JWT_SECRET=changeme
# Generate: openssl rand -hex 32
JWT_REFRESH_SECRET=changeme

# --- Meilisearch ---
# Must be at least 16 bytes or Meilisearch refuses to start.
# Generate: openssl rand -base64 32
MEILI_MASTER_KEY=changeme

# --- Vector database ---
# Only ever reached from the private `librechat` network, but the Postgres
# image still requires a password to initialise.
# Generate: openssl rand -base64 24
POSTGRES_PASSWORD=changeme

# --- Microsoft Foundry (Azure OpenAI) ---
# The full v1 endpoint, no trailing slash. LibreChat appends /chat/completions
# and /models to it. Kept out of librechat.yaml because the hostname identifies
# the Azure resource and this repo is public.
#   https://<resource>.openai.azure.com/openai/v1
AZURE_BASE_URL=changeme
# Key 1 or Key 2 from the resource's Keys and Endpoint page.
AZURE_API_KEY=changeme
