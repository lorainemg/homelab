# Served from Komodo's checkout, not baked into an image: edits here reach
# Caddy through a git pull and --watch, with no build and no restart.

{
    # Per-request HTTP metrics are opt-in in Caddy. Without this the metrics
    # endpoint serves only Go runtime and process stats — nothing about traffic.
    servers {
        metrics
    }
}

http://immich.sussman.win {
    reverse_proxy immich-server:2283
}

http://homeassistant.sussman.win {
    reverse_proxy homeassistant:8123
}

http://grafana.sussman.win {
    reverse_proxy grafana:3000
}

http://komodo.sussman.win {
    reverse_proxy komodo-core:9120
}

http://librechat.sussman.win {
    reverse_proxy librechat:3080
}

# group-split deploys itself from its own repo (Aspire-generated compose, like
# the trakt bot), so this upstream name is that stack's, not this repo's: its
# `web` service joins `internal` under the alias `group-split-web` and Kestrel
# listens on 8080. Only `web` is published — `api` and `keycloak` stay on the
# stack's private network and are reached server-side.
#
# TLS terminates at Cloudflare, so this site block is `http://` and Caddy sets
# `X-Forwarded-Proto: http` from the scheme it was reached on — overwriting
# whatever cloudflared sent, because `trusted_proxies` is not configured. The
# stack's Keycloak reads that header to decide whether the context is secure,
# and on `http` it drops `Secure` and downgrades `SameSite=None` to `Lax`. The
# browser then withholds those cookies on the account console's cross-origin
# POST to the token endpoint, which fails as `403 invalid_client`.
#
# Forced rather than trusted: `header_up` sets the value whatever Caddy or
# cloudflared put there, so the fix does not rest on what the tunnel forwards.
# Every request that arrives here came through the tunnel, where the public
# scheme is https, so stating it is accurate.
http://groupsplit.sussman.win {
    reverse_proxy group-split-web:8080 {
        header_up X-Forwarded-Proto https
    }
}

# Metrics only, on a port of its own. Caddy's admin API on localhost:2019 also
# serves /metrics, but the same API can rewrite the running config, so it stays
# on localhost where no other container can reach it. This site exposes the
# read-only endpoint to `internal` for Prometheus and nothing else. Not
# published to the host, so it is invisible from the LAN.
:2020 {
    metrics /metrics
}
